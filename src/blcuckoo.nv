// blcuckoo.nv — the cuckoo filter.
//
// A cuckoo filter answers the same question a Bloom filter does, and
// it can remove an item without the counting filter's memory.  Fan,
// Andersen, Kaminsky and Mitzenmacher published it in 2014.  At
// false-positive rates below about 3% it uses less space than a Bloom
// filter for the same rate.
//
// It stores a short fingerprint of each item, a few bits of its hash,
// in one of two buckets.  From the 64-bit hash, as the authors'
// reference implementation does, the fingerprint is the low
// `fingerprint_bits` bits, with zero read as one, and the first bucket
// is the high 32 bits modulo the bucket count.  The second bucket is
// `i XOR (fingerprint * 0x5bd1e995)` modulo the bucket count.  The
// same formula leads from either bucket to the other, so an entry can
// be moved without the item it came from.
//
// When both buckets are full, the filter evicts a fingerprint from the
// second bucket, moves it to its own other bucket, and repeats.  After
// five hundred relocations it gives up, undoes the moves it made, and
// the insert is refused.  A Bloom filter degrades gradually, and a
// cuckoo filter fails at once, which is why `add` answers a `Result`.
//
// Which entry to evict is a random choice, and this package draws no
// random numbers.  `add` takes the uniforms it may need, and
// `uniforms_needed` says how many are enough.  Each relocation
// consumes one, and entry `floor(u * entries_per_bucket)` is evicted.
//
// Removing takes out one matching fingerprint.  An item added twice
// must be removed twice.  Removing an item that was never added may
// take out a colliding fingerprint that belonged to a real item, so a
// caller removes only items it knows it added.
//
// A fingerprint is stored in the fewest whole bytes that hold it: one,
// two or four.  A filter is changed in place.

use blfault
use blshared

// A cuckoo filter.
pub struct BlCuckooFilter
    // How many buckets the filter has.  A power of two, because the
    // alternate bucket is computed with an exclusive OR.
    buckets: Int
    // How many fingerprints fit in one bucket.  Four is the usual
    // choice, and what the sizing assumes.
    entries_per_bucket: Int
    // How many bits of hash each fingerprint keeps.  Sets the
    // false-positive rate: about `2 x entries_per_bucket /
    // 2^fingerprint_bits`.
    fingerprint_bits: Int
    // The label the caller gave for the hash.
    hash_id: Str
    // The fingerprints, bucket by bucket, each big-endian in the
    // fewest whole bytes that hold it.  A zero means an empty slot,
    // which is why a fingerprint of zero is read as one.
    var entries: Bytes
    // How many fingerprints are stored.
    var stored: Int

// An empty filter sized for `capacity` items at a rate of `target`.
//
// The bucket count is the smallest power of two at or above
// `capacity / (entries_per_bucket x 0.95)`, where 0.95 is the load
// factor a four-way cuckoo filter reaches reliably.  The fingerprint
// width is `ceil(log2(2 x entries_per_bucket / target))` bits, at most
// 32, which is the bound of Fan et al. section 5.1.
//
// ```novo
// use blcuckoo
//
// fn main() [io]
//     match blcuckoo.new(1000, 0.01, "xxh3")
//         Ok(f)  => println("${blcuckoo.capacity_of(f) >= 1000}")   // true
//         Err(e) => println(e.message())
// ```
pub fn new(capacity: Int, target: Float, hash_id: Str) -> Result<BlCuckooFilter, blfault.BlFault>
    if let Some(fault) = blshared.sizing_fault(capacity, target)
        return Err(fault)
    let wanted = int.to_float(capacity) / (int.to_float(PER_BUCKET) * 0.95)
    let buckets = power_of_two_at_least(float.to_int(math.ceil(wanted)))
    let exact = math.log(2.0 * int.to_float(PER_BUCKET) / target) / math.log(2.0)
    var fingerprint = float.to_int(math.ceil(exact))
    if fingerprint > 32
        fingerprint = 32
    Ok(empty(buckets, PER_BUCKET, fingerprint, hash_id))

// Adds one item to the filter, in place.
//
// `uniforms` supplies the randomness the evictions need.  Each is a
// number in `0.0 ..< 1.0`, and they are consumed only when both
// candidate buckets are full, one per relocation.  Refused with
// `BlCuckooFull` when the uniforms run out or the relocation limit is
// reached, and then the filter is as it was before the call.  The
// filter is full, and the caller needs a larger one.
//
// ```novo
// use blcuckoo
//
// fn main() [io]
//     match blcuckoo.new(1000, 0.01, "test")
//         Err(e) => println(e.message())
//         Ok(f)  =>
//             var seen = f
//             match blcuckoo.add(seen, bytes.from_str("ada"), demo_hash, [])
//                 Ok(_)  => println("${blcuckoo.stored_count(seen)}")   // 1
//                 Err(e) => println(e.message())
//
// fn demo_hash(b: Bytes) -> Int
//     bytes.len(b) * 2654435761
// ```
pub fn add(var f: BlCuckooFilter, item: Bytes, hash: fn(Bytes) -> Int,
           uniforms: [Float]) -> Result<Unit, blfault.BlFault>
    let hashed = hash(item)
    var tag = tag_of(f, hashed)
    let first = first_bucket(f, hashed)
    if place(f, first, tag) or place(f, alternate(f, first, tag), tag)
        f.stored = f.stored + 1
        return Ok(())
    var at = alternate(f, first, tag)
    var moves: [(Int, Int, Int)] = []
    for u in uniforms
        if list.len(moves) >= KICKS
            break
        let slot = slot_of(f, u)
        let evicted = entry(f, at, slot)
        set_entry(f, at, slot, tag)
        list.push(moves, (at, slot, evicted))
        tag = evicted
        at = alternate(f, at, tag)
        if place(f, at, tag)
            f.stored = f.stored + 1
            return Ok(())
    undo(f, moves)
    Err(BlCuckooFull(list.len(moves)))

// Whether the item may be in the filter.
//
// `false` is certain.  `true` is wrong with about probability
// `2 x entries_per_bucket / 2^fingerprint_bits`.
//
// ```novo
// use blcuckoo
//
// fn main() [io]
//     match blcuckoo.new(1000, 0.01, "test")
//         Err(e) => println(e.message())
//         Ok(f)  => println("${blcuckoo.contains(f, bytes.from_str("ada"), demo_hash)}")
//
// fn demo_hash(b: Bytes) -> Int
//     bytes.len(b) * 2654435761
// ```
pub fn contains(f: BlCuckooFilter, item: Bytes, hash: fn(Bytes) -> Int) -> Bool
    let hashed = hash(item)
    let tag = tag_of(f, hashed)
    let first = first_bucket(f, hashed)
    slot_holding(f, first, tag) >= 0 or slot_holding(f, alternate(f, first, tag), tag) >= 0

// Removes one matching fingerprint from the filter, in place.
//
// Refused when neither candidate bucket holds the item's fingerprint,
// which is proof it was never added.  An item added twice must be
// removed twice.
//
// ```novo
// use blcuckoo
//
// fn main() [io]
//     match blcuckoo.new(1000, 0.01, "test")
//         Err(e) => println(e.message())
//         Ok(f)  =>
//             var seen = f
//             match blcuckoo.remove(seen, bytes.from_str("ada"), demo_hash)
//                 Ok(_)  => println("removed")
//                 Err(e) => println(e.message())
//
// fn demo_hash(b: Bytes) -> Int
//     bytes.len(b) * 2654435761
// ```
pub fn remove(var f: BlCuckooFilter, item: Bytes,
              hash: fn(Bytes) -> Int) -> Result<Unit, blfault.BlFault>
    let hashed = hash(item)
    let tag = tag_of(f, hashed)
    let first = first_bucket(f, hashed)
    let second = alternate(f, first, tag)
    let in_first = slot_holding(f, first, tag)
    if in_first >= 0
        set_entry(f, first, in_first, 0)
    else
        let in_second = slot_holding(f, second, tag)
        if in_second < 0
            return Err(BlRemoveOfUnknownItem)
        set_entry(f, second, in_second, 0)
    f.stored = f.stored - 1
    Ok(())

// How many uniform numbers one `add` may consume.
//
// The relocation limit, 500.  A caller drawing from an expensive
// generator passes fewer and handles the refusal.  A caller that wants
// the insert to have every chance passes this many.
//
// ```novo
// use blcuckoo
//
// fn main() [io]
//     match blcuckoo.new(1000, 0.01, "xxh3")
//         Ok(f)  => println("${blcuckoo.uniforms_needed(f)}")   // 500
//         Err(e) => println(e.message())
// ```
pub fn uniforms_needed(f: BlCuckooFilter) -> Int
    KICKS

// How many fingerprints are stored.
//
// ```novo
// use blcuckoo
//
// fn main() [io]
//     match blcuckoo.new(1000, 0.01, "xxh3")
//         Ok(f)  => println("${blcuckoo.stored_count(f)}")  // 0
//         Err(e) => println(e.message())
// ```
pub fn stored_count(f: BlCuckooFilter) -> Int
    f.stored

// How many fingerprints the filter has room for.
//
// `buckets x entries_per_bucket`.  Inserts begin to fail well before
// this, at about 95% of it, which is what `load_factor` is for.
//
// ```novo
// use blcuckoo
//
// fn main() [io]
//     match blcuckoo.new(1000, 0.01, "xxh3")
//         Ok(f)  => println("${blcuckoo.capacity_of(f) > 1000}")    // true
//         Err(e) => println(e.message())
// ```
pub fn capacity_of(f: BlCuckooFilter) -> Int
    f.buckets * f.entries_per_bucket

// How full the filter is, as a fraction of its slots.
//
// The number to watch: a four-way cuckoo filter takes inserts
// reliably up to about 0.95 and then starts refusing them.
//
// ```novo
// use blcuckoo
//
// fn main() [io]
//     match blcuckoo.new(1000, 0.01, "xxh3")
//         Ok(f)  => println("${blcuckoo.load_factor(f)}")   // 0
//         Err(e) => println(e.message())
// ```
pub fn load_factor(f: BlCuckooFilter) -> Float
    int.to_float(f.stored) / int.to_float(capacity_of(f))

// The false-positive rate the fingerprint width gives:
// `2 x entries_per_bucket / 2^fingerprint_bits`, the bound for a full
// filter.
//
// ```novo
// use blcuckoo
//
// fn main() [io]
//     match blcuckoo.new(1000, 0.01, "xxh3")
//         Ok(f)  => println("${blcuckoo.false_positive_rate(f) <= 0.01}")   // true
//         Err(e) => println(e.message())
// ```
pub fn false_positive_rate(f: BlCuckooFilter) -> Float
    2.0 * int.to_float(f.entries_per_bucket) / int.to_float(1 << f.fingerprint_bits)

// The filter as bytes, carrying its shape and hash label.
//
// The layout is this package's own: the four bytes `NVCF`, a version
// byte `1`, then big-endian the bucket count (8 bytes), the entries
// per bucket (1), the fingerprint width in bits (1) and the stored
// count (8), the hash label as a 16-bit length and its bytes, and the
// entries.
//
// ```novo
// use blcuckoo
//
// fn main() [io]
//     match blcuckoo.new(1000, 0.01, "xxh3")
//         Ok(f)  => println("${bytes.len(blcuckoo.to_bytes(f)) > 0}")
//         Err(e) => println(e.message())
// ```
pub fn to_bytes(f: BlCuckooFilter) -> Bytes
    let head = blshared.header(MAGIC, [
        (f.buckets, 8),
        (f.entries_per_bucket, 1),
        (f.fingerprint_bits, 1),
        (f.stored, 8)],
    f.hash_id)
    bytes.concat([head, f.entries])

// A filter read back from bytes that `to_bytes` wrote.
//
// Refused as `BlBadSerialisedForm`, saying why, when the magic, the
// version, a size or the length of the entries is wrong.
//
// ```novo
// use blcuckoo
//
// fn main() [io]
//     match blcuckoo.from_bytes(bytes.from_str(""))
//         Ok(f)  => println("${blcuckoo.stored_count(f)}")
//         Err(e) => println(e.message())
// ```
pub fn from_bytes(b: Bytes) -> Result<BlCuckooFilter, blfault.BlFault>
    let (fields, label, from) = blshared.read_header(b, MAGIC, [8, 1, 1, 8])!
    let buckets = fields[0]
    let per_bucket = fields[1]
    let fingerprint = fields[2]
    if buckets < 1 or power_of_two_at_least(buckets) != buckets or per_bucket < 1 or fingerprint < 1 or fingerprint > 32 or fields[3] < 0
        return Err(BlBadSerialisedForm("a size in the header is out of range"))
    if let Some(fault) = blshared.payload_fault(b, from, buckets * per_bucket * width_of(fingerprint))
        return Err(fault)
    Ok(BlCuckooFilter {
        buckets: buckets,
        entries_per_bucket: per_bucket,
        fingerprint_bits: fingerprint,
        hash_id: label,
        entries: bytes.slice(b, from, bytes.len(b)),
        stored: fields[3] })

// The four bytes a serialised cuckoo filter starts with.
const MAGIC: Str = "NVCF"

// The entries per bucket a new filter has.
const PER_BUCKET: Int = 4

// The most relocations one insert makes.
const KICKS: Int = 500

fn empty(buckets: Int, per_bucket: Int, fingerprint: Int, hash_id: Str) -> BlCuckooFilter
    BlCuckooFilter {
        buckets: buckets,
        entries_per_bucket: per_bucket,
        fingerprint_bits: fingerprint,
        hash_id: hash_id,
        entries: bytes.zeros(buckets * per_bucket * width_of(fingerprint)),
        stored: 0 }

// The smallest power of two at or above `n`, and at least one.
fn power_of_two_at_least(n: Int) -> Int
    var p = 1
    for _ in 0..62
        if p >= n
            break
        p = p * 2
    p

// The bytes one fingerprint of `bits` bits is stored in.
fn width_of(bits: Int) -> Int
    if bits <= 8
        return 1
    if bits <= 16
        return 2
    4

// The low `fingerprint_bits` bits of the hash, with zero read as one.
fn tag_of(f: BlCuckooFilter, hashed: Int) -> Int
    let tag = hashed & ((1 << f.fingerprint_bits) - 1)
    if tag == 0
        return 1
    tag

// The high 32 bits of the hash, modulo the bucket count.
fn first_bucket(f: BlCuckooFilter, hashed: Int) -> Int
    blshared.high_half(hashed) & (f.buckets - 1)

// The other bucket a fingerprint in bucket `i` may live in.
fn alternate(f: BlCuckooFilter, i: Int, tag: Int) -> Int
    (i ^ int.wrapping_mul(tag, 0x5bd1e995)) & (f.buckets - 1)

// The entry a uniform picks within a bucket.
fn slot_of(f: BlCuckooFilter, u: Float) -> Int
    let slot = float.to_int(u * int.to_float(f.entries_per_bucket))
    if slot < 0
        return 0
    if slot >= f.entries_per_bucket
        return f.entries_per_bucket - 1
    slot

fn entry(f: BlCuckooFilter, bucket: Int, slot: Int) -> Int
    let w = width_of(f.fingerprint_bits)
    let off = (bucket * f.entries_per_bucket + slot) * w
    match w
        1 => bytes.byte_at(f.entries, off) ?? 0
        2 => bytes.u16_be_at(f.entries, off) ?? 0
        _ => bytes.u32_be_at(f.entries, off) ?? 0

fn set_entry(var f: BlCuckooFilter, bucket: Int, slot: Int, tag: Int)
    let w = width_of(f.fingerprint_bits)
    let off = (bucket * f.entries_per_bucket + slot) * w
    match w
        1 => bytes.set_u8(f.entries, off, tag)
        2 => bytes.set_u16_be(f.entries, off, tag)
        _ => bytes.set_u32_be(f.entries, off, tag)

// The first slot in `bucket` holding `tag`, or `-1`.
fn slot_holding(f: BlCuckooFilter, bucket: Int, tag: Int) -> Int
    for slot in 0..f.entries_per_bucket
        if entry(f, bucket, slot) == tag
            return slot
    0 - 1

// Puts `tag` in an empty slot of `bucket`, answering whether there was
// one.
fn place(var f: BlCuckooFilter, bucket: Int, tag: Int) -> Bool
    let slot = slot_holding(f, bucket, 0)
    if slot < 0
        return false
    set_entry(f, bucket, slot, tag)
    true

// Puts back, last first, what each relocation took out.
fn undo(var f: BlCuckooFilter, moves: [(Int, Int, Int)])
    for (bucket, slot, evicted) in list.rev(moves)
        set_entry(f, bucket, slot, evicted)
