// blcuckoo.nv — the cuckoo filter.
//
// WHAT IT IS
//
// A cuckoo filter answers the same question a Bloom filter does, and
// it can delete without the sixteen-fold cost of a counting filter.
// Fan, Andersen, Kaminsky and Mitzenmacher published it in 2014, and
// at false-positive rates below about 3% it uses LESS space than a
// Bloom filter for the same rate.
//
// It stores a short FINGERPRINT of each item — a few bits of its hash
// — in one of two buckets.  The two candidate buckets are `i` and
// `i XOR hash(fingerprint)`, which is the trick that makes the
// structure work: from an entry alone, without the item, the other
// bucket it could live in can be computed.
//
// INSERTING CAN FAIL, AND IT SAYS SO
//
// When both buckets are full, the filter evicts an existing
// fingerprint, moves it to its own alternate bucket, and repeats.
// After a limit — five hundred relocations — it gives up, and the
// insert is refused.  That is the price of the space: a Bloom filter
// degrades gracefully and a cuckoo filter fails abruptly.  `add`
// answers a `Result` for that reason.
//
// THE EVICTIONS NEED RANDOMNESS, AND IT COMES FROM THE CALLER
//
// Which entry to evict is a random choice.  This package draws no
// random numbers, so `add` takes the uniforms it may need, as
// `backoff-nv` and `skreservoir` do.  A caller that wants a
// deterministic build hands in a fixed list; `uniforms_needed` says
// how many are enough.
//
// DELETING IS SAFE, WITH ONE RULE
//
// Deleting removes one matching fingerprint.  An item added twice must
// be deleted twice, and deleting an item that was never added may
// remove a colliding fingerprint that belonged to a real item — so a
// caller must only delete items it knows it added.  That rule is the
// same one a counting filter has, and it cannot be checked here.

use blfault

// A cuckoo filter.
pub struct BlCuckooFilter
    // How many buckets the filter has.  A power of two, because the
    // alternate bucket is computed with an exclusive OR.
    buckets: Int
    // How many fingerprints fit in one bucket.  Four is the usual
    // choice, and what the sizing assumes.
    entries_per_bucket: Int
    // How many bits of hash each fingerprint keeps.  Sets the
    // false-positive rate: about `2 x entries_per_bucket /
    // 2^fingerprint_bits`.
    fingerprint_bits: Int
    // The label the caller gave for the hash.
    hash_id: Str
    // The fingerprints, bucket by bucket.  A zero means an empty slot,
    // which is why a fingerprint of zero is mapped to one.
    entries: Bytes
    // How many fingerprints are stored.
    stored: Int

// An empty filter sized for `capacity` items at a rate of `target`.
//
// The bucket count is the next power of two above
// `capacity / (entries_per_bucket x 0.95)` — the 0.95 is the load
// factor a four-way cuckoo filter reaches reliably — and the
// fingerprint width comes from the target rate.
//
// ```novo
// use blcuckoo
//
// fn main() [io]
//     match blcuckoo.new(1000, 0.01, "xxh3")
//         Ok(f)  => println("${blcuckoo.capacity_of(f) >= 1000}")   // true
//         Err(e) => println(e.message())
// ```
pub fn new(capacity: Int, target: Float, hash_id: Str) -> Result<BlCuckooFilter, blfault.BlFault>
    todo("bloom-nv.blcuckoo.new")

// The filter with one item added.
//
// `uniforms` supplies the randomness the evictions need; each is a
// number in `0.0 ..< 1.0`, and they are consumed only when both
// candidate buckets are full.  Refused with `BlCuckooFull` when the
// relocation limit is reached, which means the filter is full and the
// caller needs a larger one.
//
// ```novo
// use blcuckoo
//
// fn main() [io]
//     match blcuckoo.new(1000, 0.01, "test")
//         Err(e) => println(e.message())
//         Ok(f)  =>
//             match blcuckoo.add(f, bytes.from_str("ada"), demo_hash, [])
//                 Ok(g)  => println("${blcuckoo.stored_count(g)}")      // 1
//                 Err(e) => println(e.message())
//
// fn demo_hash(b: Bytes) -> Int
//     bytes.len(b) * 2654435761
// ```
pub fn add(f: BlCuckooFilter, item: Bytes, hash: fn(Bytes) -> Int,
           uniforms: [Float]) -> Result<BlCuckooFilter, blfault.BlFault>
    todo("bloom-nv.blcuckoo.add")

// Whether the item may be in the filter.
//
// `false` is certain.  `true` is wrong with about probability
// `2 x entries_per_bucket / 2^fingerprint_bits`.
//
// ```novo
// use blcuckoo
//
// fn main() [io]
//     match blcuckoo.new(1000, 0.01, "test")
//         Err(e) => println(e.message())
//         Ok(f)  => println("${blcuckoo.contains(f, bytes.from_str("ada"), demo_hash)}")
//
// fn demo_hash(b: Bytes) -> Int
//     bytes.len(b) * 2654435761
// ```
pub fn contains(f: BlCuckooFilter, item: Bytes, hash: fn(Bytes) -> Int) -> Bool
    todo("bloom-nv.blcuckoo.contains")

// The filter with one matching fingerprint removed.
//
// Refused when neither candidate bucket holds the item's fingerprint,
// which is proof it was never added.  An item added twice must be
// removed twice.
//
// ```novo
// use blcuckoo
//
// fn main() [io]
//     match blcuckoo.new(1000, 0.01, "test")
//         Err(e) => println(e.message())
//         Ok(f)  =>
//             match blcuckoo.remove(f, bytes.from_str("ada"), demo_hash)
//                 Ok(_)  => println("removed")
//                 Err(e) => println(e.message())
//
// fn demo_hash(b: Bytes) -> Int
//     bytes.len(b) * 2654435761
// ```
pub fn remove(f: BlCuckooFilter, item: Bytes,
              hash: fn(Bytes) -> Int) -> Result<BlCuckooFilter, blfault.BlFault>
    todo("bloom-nv.blcuckoo.remove")

// How many uniform numbers one `add` may consume.
//
// The relocation limit.  A caller drawing from an expensive generator
// passes fewer and handles the refusal; a caller that wants the insert
// to have every chance passes this many.
//
// ```novo
// use blcuckoo
//
// fn main() [io]
//     match blcuckoo.new(1000, 0.01, "xxh3")
//         Ok(f)  => println("${blcuckoo.uniforms_needed(f)}")   // 500
//         Err(e) => println(e.message())
// ```
pub fn uniforms_needed(f: BlCuckooFilter) -> Int
    todo("bloom-nv.blcuckoo.uniforms_needed")

// How many fingerprints are stored.
//
// ```novo
// use blcuckoo
//
// fn main() [io]
//     match blcuckoo.new(1000, 0.01, "xxh3")
//         Ok(f)  => println("${blcuckoo.stored_count(f)}")  // 0
//         Err(e) => println(e.message())
// ```
pub fn stored_count(f: BlCuckooFilter) -> Int
    todo("bloom-nv.blcuckoo.stored_count")

// How many fingerprints the filter has room for.
//
// `buckets x entries_per_bucket`.  Inserts begin to fail well before
// this, at about 95% of it, which is what `load_factor` is for.
//
// ```novo
// use blcuckoo
//
// fn main() [io]
//     match blcuckoo.new(1000, 0.01, "xxh3")
//         Ok(f)  => println("${blcuckoo.capacity_of(f) > 1000}")    // true
//         Err(e) => println(e.message())
// ```
pub fn capacity_of(f: BlCuckooFilter) -> Int
    todo("bloom-nv.blcuckoo.capacity_of")

// How full the filter is, as a fraction of its slots.
//
// The number to watch: a four-way cuckoo filter takes inserts
// reliably up to about 0.95 and then starts refusing them.
//
// ```novo
// use blcuckoo
//
// fn main() [io]
//     match blcuckoo.new(1000, 0.01, "xxh3")
//         Ok(f)  => println("${blcuckoo.load_factor(f)}")   // 0
//         Err(e) => println(e.message())
// ```
pub fn load_factor(f: BlCuckooFilter) -> Float
    todo("bloom-nv.blcuckoo.load_factor")

// The false-positive rate the fingerprint width gives.
//
// ```novo
// use blcuckoo
//
// fn main() [io]
//     match blcuckoo.new(1000, 0.01, "xxh3")
//         Ok(f)  => println("${blcuckoo.false_positive_rate(f) <= 0.01}")   // true
//         Err(e) => println(e.message())
// ```
pub fn false_positive_rate(f: BlCuckooFilter) -> Float
    todo("bloom-nv.blcuckoo.false_positive_rate")

// The filter as bytes, carrying its shape and hash label.
//
// ```novo
// use blcuckoo
//
// fn main() [io]
//     match blcuckoo.new(1000, 0.01, "xxh3")
//         Ok(f)  => println("${bytes.len(blcuckoo.to_bytes(f)) > 0}")
//         Err(e) => println(e.message())
// ```
pub fn to_bytes(f: BlCuckooFilter) -> Bytes
    todo("bloom-nv.blcuckoo.to_bytes")

// A filter read back from bytes.
//
// ```novo
// use blcuckoo
//
// fn main() [io]
//     match blcuckoo.from_bytes(bytes.from_str(""))
//         Ok(f)  => println("${blcuckoo.stored_count(f)}")
//         Err(e) => println(e.message())
// ```
pub fn from_bytes(b: Bytes) -> Result<BlCuckooFilter, blfault.BlFault>
    todo("bloom-nv.blcuckoo.from_bytes")
