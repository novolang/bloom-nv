// blbloom.nv — the Bloom filter.
//
// A Bloom filter answers one question, "have I seen this?", in a few
// bits per item, with a one-sided error.  `false` means the item was
// never added.  `true` means it probably was: with probability at most
// the rate the filter was sized for, it is a false positive and the
// item was never added.  There are no false negatives, so a caller can
// skip an expensive lookup whenever the filter says `false`.  Burton
// Bloom's 1970 paper is the original.
//
// Two numbers fix the filter: how many items are expected, and what
// false-positive rate is acceptable.  From those the bit count is
// `-n ln p / (ln 2)^2` and the hash count is `(m / n) ln 2`, which is
// about ten bits per item for one per cent and fifteen for one per
// thousand.  `new` does that arithmetic, and `with_bits` is for a
// caller matching another implementation's parameters.
//
// A filter that holds more items than it was sized for goes on working
// with a higher rate, and nothing is refused.  `false_positive_rate`
// answers the rate at the current fill, and `is_saturated` says when
// the fill has passed the capacity.
//
// The `k` positions of an item come from one 64-bit hash by the
// construction of Kirsch and Mitzenmacher (2006):
// `g_i = (h1 + i * h2) mod m` for `i` from `0` to `k - 1`, with `h1`
// the low 32 bits of the hash and `h2` the high 32 bits, both
// unsigned.  Bit `g` is bit `g mod 8` of byte `g / 8`, the lowest bit
// first.
//
// A filter is changed in place.  `add` writes into the filter it is
// given, so a caller keeps the filter in a `var` binding, and adding
// an item costs `k` bit writes whatever the filter's size.

use blfault
use blshared

// A Bloom filter.
pub struct BloomFilter
    // How many bits the filter has.
    bits: Int
    // How many positions each item sets.
    hashes: Int
    // The label the caller gave for the hash the filter was fed
    // through.
    hash_id: Str
    // How many items the filter was sized for.  For a filter built
    // with `with_bits`, the count for which its sizing is optimal,
    // `m ln 2 / k`.
    capacity: Int
    // The false-positive rate the filter was sized for, or `0.0` when
    // it was built with `with_bits`.
    target: Float
    // The bits themselves, eight to a byte.
    var bitmap: Bytes
    // How many items have been added, which is what the current
    // false-positive rate is computed from.
    var inserted: Int

// An empty filter sized for `capacity` items at a false-positive rate
// of `target`.
//
// `target` is a fraction in `0.0 ..< 1.0`: `0.01` is one per cent.
// The bit count and the hash count are computed from the two, and a
// caller that cares about the memory reads `bit_count` back.
//
// ```novo
// use blbloom
//
// fn main() [io]
//     match blbloom.new(1000, 0.01, "xxh3")
//         Ok(f)  => println("${blbloom.hash_count(f)}")     // 7
//         Err(e) => println(e.message())
// ```
pub fn new(capacity: Int, target: Float, hash_id: Str) -> Result<BloomFilter, blfault.BlFault>
    match blshared.sizing_fault(capacity, target)
        Some(fault) => Err(fault)
        None        =>
            let width = blshared.optimal_bits(capacity, target)
            Ok(empty(width, blshared.optimal_hashes(width, capacity), hash_id, capacity, target))

// An empty filter with the bit count and hash count given directly.
//
// For a caller matching another implementation's parameters, or one
// that has a fixed amount of memory and wants to know what rate it
// buys.  `false_positive_rate` answers that.  A bit count or a hash
// count below one is refused as `BlCapacityNotPositive`, naming it.
//
// ```novo
// use blbloom
//
// fn main() [io]
//     match blbloom.with_bits(9600, 7, "xxh3")
//         Ok(f)  => println("${blbloom.bit_count(f)}")      // 9600
//         Err(e) => println(e.message())
// ```
pub fn with_bits(bits: Int, hashes: Int, hash_id: Str) -> Result<BloomFilter, blfault.BlFault>
    if bits < 1
        return Err(BlCapacityNotPositive(bits))
    if hashes < 1
        return Err(BlCapacityNotPositive(hashes))
    Ok(empty(bits, hashes, hash_id, blshared.natural_capacity(bits, hashes), 0.0))

// Adds one item to the filter, in place.
//
// Adding an item twice sets no new bit.  A Bloom filter cannot count,
// and `inserted_count` is what was offered rather than what is
// distinct.
//
// ```novo
// use blbloom
//
// fn main() [io]
//     match blbloom.new(1000, 0.01, "test")
//         Err(e) => println(e.message())
//         Ok(f)  =>
//             var seen = f
//             blbloom.add(seen, bytes.from_str("ada"), demo_hash)
//             println("${blbloom.contains(seen, bytes.from_str("ada"), demo_hash)}")
//
// fn demo_hash(b: Bytes) -> Int
//     bytes.len(b) * 2654435761
// ```
pub fn add(var f: BloomFilter, item: Bytes, hash: fn(Bytes) -> Int)
    add_hashed(f, hash(item))

// Adds one already-hashed item to the filter, in place.
//
// ```novo
// use blbloom
//
// fn main() [io]
//     match blbloom.new(1000, 0.01, "xxh3")
//         Ok(f)  =>
//             var seen = f
//             blbloom.add_hashed(seen, 981723)
//             println("${blbloom.inserted_count(seen)}")    // 1
//         Err(e) => println(e.message())
// ```
pub fn add_hashed(var f: BloomFilter, hashed: Int)
    for i in 0..f.hashes
        let g = blshared.position(hashed, i, f.bits)
        let byte = bytes.byte_at(f.bitmap, g / 8) ?? 0
        bytes.set_u8(f.bitmap, g / 8, byte | (1 << (g % 8)))
    f.inserted = f.inserted + 1

// Whether the item may have been added.
//
// `false` is certain: the item was never added.  `true` is probable,
// and wrong with at most the probability `false_positive_rate`
// answers.
//
// ```novo
// use blbloom
//
// fn main() [io]
//     match blbloom.new(1000, 0.01, "test")
//         Err(e) => println(e.message())
//         Ok(f)  => println("${blbloom.contains(f, bytes.from_str("ada"), demo_hash)}")
//
// fn demo_hash(b: Bytes) -> Int
//     bytes.len(b) * 2654435761
// ```
pub fn contains(f: BloomFilter, item: Bytes, hash: fn(Bytes) -> Int) -> Bool
    contains_hashed(f, hash(item))

// Whether an already-hashed item may have been added.
//
// ```novo
// use blbloom
//
// fn main() [io]
//     match blbloom.new(1000, 0.01, "xxh3")
//         Ok(f)  => println("${blbloom.contains_hashed(f, 981723)}")    // false
//         Err(e) => println(e.message())
// ```
pub fn contains_hashed(f: BloomFilter, hashed: Int) -> Bool
    for i in 0..f.hashes
        let g = blshared.position(hashed, i, f.bits)
        let byte = bytes.byte_at(f.bitmap, g / 8) ?? 0
        if (byte & (1 << (g % 8))) == 0
            return false
    true

// The false-positive rate at the current fill.
//
// `(1 - e^(-k n / m))^k`, with `n` the number of items added.  An
// empty filter answers `0.0`, a filter at its capacity answers about
// its target, and a filter past its capacity answers a number that
// keeps climbing.  That is the number a caller acts on, rather than
// the target the filter was built with.
//
// ```novo
// use blbloom
//
// fn main() [io]
//     match blbloom.new(1000, 0.01, "xxh3")
//         Ok(f)  => println("${blbloom.false_positive_rate(f)}")        // 0
//         Err(e) => println(e.message())
// ```
pub fn false_positive_rate(f: BloomFilter) -> Float
    blshared.rate(f.hashes, f.inserted, f.bits)

// The rate the filter was sized for, or `0.0` when it was built with
// `with_bits`.
//
// ```novo
// use blbloom
//
// fn main() [io]
//     match blbloom.new(1000, 0.01, "xxh3")
//         Ok(f)  => println("${blbloom.target_rate(f) == 0.01}")        // true
//         Err(e) => println(e.message())
// ```
pub fn target_rate(f: BloomFilter) -> Float
    f.target

// Whether more items have been added than the filter was sized for.
//
// The filter still works; its false-positive rate is simply above the
// target.  A caller checks this on a schedule and rebuilds at a larger
// size, because nothing else will tell it.
//
// ```novo
// use blbloom
//
// fn main() [io]
//     match blbloom.new(1000, 0.01, "xxh3")
//         Ok(f)  => println("${blbloom.is_saturated(f)}")   // false
//         Err(e) => println(e.message())
// ```
pub fn is_saturated(f: BloomFilter) -> Bool
    f.inserted > f.capacity

// How many bits the filter has.
//
// ```novo
// use blbloom
//
// fn main() [io]
//     match blbloom.new(1000, 0.01, "xxh3")
//         Ok(f)  => println("${blbloom.bit_count(f) > 9000}")           // true
//         Err(e) => println(e.message())
// ```
pub fn bit_count(f: BloomFilter) -> Int
    f.bits

// How many positions each item sets.
//
// ```novo
// use blbloom
//
// fn main() [io]
//     match blbloom.new(1000, 0.01, "xxh3")
//         Ok(f)  => println("${blbloom.hash_count(f)}")     // 7
//         Err(e) => println(e.message())
// ```
pub fn hash_count(f: BloomFilter) -> Int
    f.hashes

// How many items have been added.
//
// What was offered, not what is distinct: a Bloom filter cannot tell
// the difference.
//
// ```novo
// use blbloom
//
// fn main() [io]
//     match blbloom.new(1000, 0.01, "xxh3")
//         Ok(f)  => println("${blbloom.inserted_count(f)}")  // 0
//         Err(e) => println(e.message())
// ```
pub fn inserted_count(f: BloomFilter) -> Int
    f.inserted

// The filter that holds everything both hold.
//
// A bitwise OR, and it is exact: the union of two filters is the
// filter that would have had both streams added to it.  Its inserted
// count is the sum of the two.  Refused when the shapes differ, and
// then when the hash labels differ.  Neither input is changed.
//
// ```novo
// use blbloom
//
// fn main() [io]
//     match blbloom.new(1000, 0.01, "xxh3")
//         Err(e) => println(e.message())
//         Ok(f)  =>
//             match blbloom.union(f, f)
//                 Ok(u)  => println("${blbloom.inserted_count(u)}")     // 0
//                 Err(e) => println(e.message())
// ```
pub fn union(a: BloomFilter, b: BloomFilter) -> Result<BloomFilter, blfault.BlFault>
    match mismatch(a, b)
        Some(fault) => Err(fault)
        None        => Ok(combined(a, b, true))

// The filter of the items both hold: a bitwise AND, which is not
// exact.
//
// The result answers `true` for any item whose bits happen to be set
// in both filters for different reasons, so its false-positive rate is
// higher than either input's and is not bounded by the target.  Its
// inserted count is the smaller of the two, and `false_positive_rate`
// computed from it means nothing.  Refused as `union` is.
//
// ```novo
// use blbloom
//
// fn main() [io]
//     match blbloom.new(1000, 0.01, "xxh3")
//         Err(e) => println(e.message())
//         Ok(f)  =>
//             match blbloom.intersection(f, f)
//                 Ok(i)  => println("${blbloom.bit_count(i) > 0}")      // true
//                 Err(e) => println(e.message())
// ```
pub fn intersection(a: BloomFilter, b: BloomFilter) -> Result<BloomFilter, blfault.BlFault>
    match mismatch(a, b)
        Some(fault) => Err(fault)
        None        => Ok(combined(a, b, false))

// The filter as bytes, carrying its shape and hash label.
//
// The layout is this package's own: the four bytes `NVBF`, a version
// byte `1`, then big-endian the bit count (8 bytes), the hash count
// (4), the capacity (8), the inserted count (8) and the bits of the
// target rate as an IEEE 754 double (8), the hash label as a 16-bit
// length and its bytes, and the bitmap.
//
// ```novo
// use blbloom
//
// fn main() [io]
//     match blbloom.new(1000, 0.01, "xxh3")
//         Ok(f)  => println("${bytes.len(blbloom.to_bytes(f)) > 0}")    // true
//         Err(e) => println(e.message())
// ```
pub fn to_bytes(f: BloomFilter) -> Bytes
    let head = blshared.header(MAGIC, [
        (f.bits, 8),
        (f.hashes, 4),
        (f.capacity, 8),
        (f.inserted, 8),
        (float.to_bits(f.target), 8)],
    f.hash_id)
    bytes.concat([head, f.bitmap])

// A filter read back from bytes that `to_bytes` wrote.
//
// Refused as `BlBadSerialisedForm`, saying why, when the magic, the
// version, a size or the bitmap's length is wrong.
//
// ```novo
// use blbloom
//
// fn main() [io]
//     match blbloom.from_bytes(bytes.from_str(""))
//         Ok(f)  => println("${blbloom.bit_count(f)}")
//         Err(e) => println(e.message())
// ```
pub fn from_bytes(b: Bytes) -> Result<BloomFilter, blfault.BlFault>
    let (fields, label, from) = blshared.read_header(b, MAGIC, [8, 4, 8, 8, 8])!
    let width = fields[0]
    let hashes = fields[1]
    if width < 1 or hashes < 1 or fields[2] < 1 or fields[3] < 0
        return Err(BlBadSerialisedForm("a size in the header is out of range"))
    if let Some(fault) = blshared.payload_fault(b, from, (width + 7) / 8)
        return Err(fault)
    Ok(BloomFilter {
        bits: width,
        hashes: hashes,
        hash_id: label,
        capacity: fields[2],
        target: float.from_bits(fields[4]),
        bitmap: bytes.slice(b, from, bytes.len(b)),
        inserted: fields[3] })

// The four bytes a serialised Bloom filter starts with.
const MAGIC: Str = "NVBF"

fn empty(bits: Int, hashes: Int, hash_id: Str, capacity: Int, target: Float) -> BloomFilter
    BloomFilter {
        bits: bits,
        hashes: hashes,
        hash_id: hash_id,
        capacity: capacity,
        target: target,
        bitmap: bytes.zeros((bits + 7) / 8),
        inserted: 0 }

// Why two filters cannot be combined, or `None`.
fn mismatch(a: BloomFilter, b: BloomFilter) -> ?blfault.BlFault
    if a.bits != b.bits or a.hashes != b.hashes
        return Some(BlShapeMismatch(shape_text(a), shape_text(b)))
    if a.hash_id != b.hash_id
        return Some(BlHashMismatch(a.hash_id, b.hash_id))
    None

fn shape_text(f: BloomFilter) -> Str
    "${f.bits} bits, ${f.hashes} hashes"

// The bitwise OR of two filters of one shape when `either` is set, and
// their AND otherwise.
fn combined(a: BloomFilter, b: BloomFilter, either: Bool) -> BloomFilter
    var out = empty(a.bits, a.hashes, a.hash_id, a.capacity, a.target)
    for i in 0..bytes.len(a.bitmap)
        let x = bytes.byte_at(a.bitmap, i) ?? 0
        let y = bytes.byte_at(b.bitmap, i) ?? 0
        if either
            bytes.set_u8(out.bitmap, i, x | y)
        else
            bytes.set_u8(out.bitmap, i, x & y)
    if either
        out.inserted = a.inserted + b.inserted
    else if a.inserted < b.inserted
        out.inserted = a.inserted
    else
        out.inserted = b.inserted
    out
