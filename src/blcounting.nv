// blcounting.nv — the counting Bloom filter, which can remove.
//
// A plain Bloom filter cannot remove an item: clearing its bits would
// clear bits that other items set, and the filter would start
// answering `false` for things it holds.  That is a false negative,
// the one answer these structures never give.
//
// A counting filter replaces each bit with a four-bit counter.  Adding
// increments the item's counters, removing decrements them, and a
// position is set while its counter is above zero.  The sizing and the
// positions are the plain filter's, and the memory is four times as
// much.
//
// Two operations would break the filter, and both are refused.  A
// counter at fifteen cannot be incremented without wrapping to zero,
// so an add that would overflow one is refused.  A remove of an item
// whose counters include a zero is proof the item was never added, so
// that remove is refused too.  A remove of an item that was never added
// but whose counters are all above zero, because other items share
// them, cannot be detected, and it is the one way to make this filter
// report a false negative.
//
// Counter `j` is the low four bits of byte `j / 2` when `j` is even and
// the high four bits when it is odd.  A filter is changed in place.

use blfault
use blshared

// A counting Bloom filter, with four-bit counters.
pub struct BlCountingFilter
    // How many counters the filter has.
    slots: Int
    // How many counters each item touches.
    hashes: Int
    // The label the caller gave for the hash.
    hash_id: Str
    // How many items the filter was sized for.
    capacity: Int
    // The counters, two to a byte.
    var counters: Bytes
    // How many items are currently in the filter: added, less
    // removed.
    var present: Int

// An empty counting filter sized for `capacity` items at a rate of
// `target`.
//
// The sizing is the plain filter's, and the memory is four times as
// much, because each bit becomes a four-bit counter.
//
// ```novo
// use blcounting
//
// fn main() [io]
//     match blcounting.new(1000, 0.01, "xxh3")
//         Ok(f)  => println("${blcounting.hash_count(f)}")  // 7
//         Err(e) => println(e.message())
// ```
pub fn new(capacity: Int, target: Float, hash_id: Str) -> Result<BlCountingFilter, blfault.BlFault>
    match blshared.sizing_fault(capacity, target)
        Some(fault) => Err(fault)
        None        =>
            let slots = blshared.optimal_bits(capacity, target)
            Ok(BlCountingFilter {
                slots: slots,
                hashes: blshared.optimal_hashes(slots, capacity),
                hash_id: hash_id,
                capacity: capacity,
                counters: bytes.zeros((slots + 1) / 2),
                present: 0 })

// Adds one item to the filter, in place.
//
// Refused, with nothing changed, when one of the item's counters would
// pass fifteen: the increment would wrap, and a wrapped counter turns
// a later `remove` into a false negative.
//
// ```novo
// use blcounting
//
// fn main() [io]
//     match blcounting.new(1000, 0.01, "test")
//         Err(e) => println(e.message())
//         Ok(f)  =>
//             var seen = f
//             match blcounting.add(seen, bytes.from_str("ada"), demo_hash)
//                 Ok(_)  => println("${blcounting.present_count(seen)}")   // 1
//                 Err(e) => println(e.message())
//
// fn demo_hash(b: Bytes) -> Int
//     bytes.len(b) * 2654435761
// ```
pub fn add(var f: BlCountingFilter, item: Bytes,
           hash: fn(Bytes) -> Int) -> Result<Unit, blfault.BlFault>
    let hashed = hash(item)
    for i in 0..f.hashes
        let j = blshared.position(hashed, i, f.slots)
        if counter(f, j) + blshared.repeats(hashed, f.hashes, f.slots, j) > LARGEST
            return Err(BlCounterSaturated(j))
    for i in 0..f.hashes
        let j = blshared.position(hashed, i, f.slots)
        set_counter(f, j, counter(f, j) + 1)
    f.present = f.present + 1
    Ok(())

// Removes one item from the filter, in place.
//
// Refused, with nothing changed, when any of the item's counters is
// zero, which is proof the item was never added.  A remove of an item
// that was never added but whose positions collide with items that
// were cannot be detected, and it is the one way this filter can be
// made to report a false negative.
//
// ```novo
// use blcounting
//
// fn main() [io]
//     match blcounting.new(1000, 0.01, "test")
//         Err(e) => println(e.message())
//         Ok(f)  =>
//             var seen = f
//             match blcounting.remove(seen, bytes.from_str("ada"), demo_hash)
//                 Ok(_)  => println("removed")
//                 Err(e) => println(e.message())
//
// fn demo_hash(b: Bytes) -> Int
//     bytes.len(b) * 2654435761
// ```
pub fn remove(var f: BlCountingFilter, item: Bytes,
              hash: fn(Bytes) -> Int) -> Result<Unit, blfault.BlFault>
    let hashed = hash(item)
    for i in 0..f.hashes
        let j = blshared.position(hashed, i, f.slots)
        if counter(f, j) < blshared.repeats(hashed, f.hashes, f.slots, j)
            return Err(BlRemoveOfUnknownItem)
    for i in 0..f.hashes
        let j = blshared.position(hashed, i, f.slots)
        set_counter(f, j, counter(f, j) - 1)
    f.present = f.present - 1
    Ok(())

// Whether the item may be in the filter.
//
// `false` is certain, as in the plain filter.
//
// ```novo
// use blcounting
//
// fn main() [io]
//     match blcounting.new(1000, 0.01, "test")
//         Err(e) => println(e.message())
//         Ok(f)  => println("${blcounting.contains(f, bytes.from_str("ada"), demo_hash)}")
//
// fn demo_hash(b: Bytes) -> Int
//     bytes.len(b) * 2654435761
// ```
pub fn contains(f: BlCountingFilter, item: Bytes, hash: fn(Bytes) -> Int) -> Bool
    min_counter(f, item, hash) > 0

// The smallest of an item's counters.
//
// An upper bound on how many times the item was added, which is the
// count-min estimate over four-bit counters, and `0` is the proof that
// it was never added.  It is the number `remove` refuses on, and it
// tells a caller how close a counter is to saturating.
//
// ```novo
// use blcounting
//
// fn main() [io]
//     match blcounting.new(1000, 0.01, "test")
//         Err(e) => println(e.message())
//         Ok(f)  => println("${blcounting.min_counter(f, bytes.from_str("ada"), demo_hash)}")
//
// fn demo_hash(b: Bytes) -> Int
//     bytes.len(b) * 2654435761
// ```
pub fn min_counter(f: BlCountingFilter, item: Bytes, hash: fn(Bytes) -> Int) -> Int
    let hashed = hash(item)
    var least = LARGEST
    for i in 0..f.hashes
        let c = counter(f, blshared.position(hashed, i, f.slots))
        if c < least
            least = c
    least

// How many items are currently in the filter: added, less removed.
//
// ```novo
// use blcounting
//
// fn main() [io]
//     match blcounting.new(1000, 0.01, "xxh3")
//         Ok(f)  => println("${blcounting.present_count(f)}")   // 0
//         Err(e) => println(e.message())
// ```
pub fn present_count(f: BlCountingFilter) -> Int
    f.present

// The false-positive rate at the current fill.
//
// ```novo
// use blcounting
//
// fn main() [io]
//     match blcounting.new(1000, 0.01, "xxh3")
//         Ok(f)  => println("${blcounting.false_positive_rate(f)}")     // 0
//         Err(e) => println(e.message())
// ```
pub fn false_positive_rate(f: BlCountingFilter) -> Float
    blshared.rate(f.hashes, f.present, f.slots)

// How many counters each item touches.
//
// ```novo
// use blcounting
//
// fn main() [io]
//     match blcounting.new(1000, 0.01, "xxh3")
//         Ok(f)  => println("${blcounting.hash_count(f)}")  // 7
//         Err(e) => println(e.message())
// ```
pub fn hash_count(f: BlCountingFilter) -> Int
    f.hashes

// The filter as bytes, carrying its shape and hash label.
//
// The layout is this package's own: the four bytes `NVCB`, a version
// byte `1`, then big-endian the counter count (8 bytes), the hash
// count (4), the capacity (8) and the present count (8), the hash
// label as a 16-bit length and its bytes, and the counters.
//
// ```novo
// use blcounting
//
// fn main() [io]
//     match blcounting.new(1000, 0.01, "xxh3")
//         Ok(f)  => println("${bytes.len(blcounting.to_bytes(f)) > 0}")
//         Err(e) => println(e.message())
// ```
pub fn to_bytes(f: BlCountingFilter) -> Bytes
    let head = blshared.header(MAGIC, [(f.slots, 8), (f.hashes, 4), (f.capacity, 8), (f.present, 8)], f.hash_id)
    bytes.concat([head, f.counters])

// A filter read back from bytes that `to_bytes` wrote.
//
// Refused as `BlBadSerialisedForm`, saying why, when the magic, the
// version, a size or the length of the counters is wrong.
//
// ```novo
// use blcounting
//
// fn main() [io]
//     match blcounting.from_bytes(bytes.from_str(""))
//         Ok(f)  => println("${blcounting.present_count(f)}")
//         Err(e) => println(e.message())
// ```
pub fn from_bytes(b: Bytes) -> Result<BlCountingFilter, blfault.BlFault>
    let (fields, label, from) = blshared.read_header(b, MAGIC, [8, 4, 8, 8])!
    let slots = fields[0]
    if slots < 1 or fields[1] < 1 or fields[2] < 1 or fields[3] < 0
        return Err(BlBadSerialisedForm("a size in the header is out of range"))
    if let Some(fault) = blshared.payload_fault(b, from, (slots + 1) / 2)
        return Err(fault)
    Ok(BlCountingFilter {
        slots: slots,
        hashes: fields[1],
        hash_id: label,
        capacity: fields[2],
        counters: bytes.slice(b, from, bytes.len(b)),
        present: fields[3] })

// The four bytes a serialised counting filter starts with.
const MAGIC: Str = "NVCB"

// The most a four-bit counter holds.
const LARGEST: Int = 15

// Counter `j`: the low four bits of byte `j / 2` for an even `j`, the
// high four bits for an odd one.
fn counter(f: BlCountingFilter, j: Int) -> Int
    let byte = bytes.byte_at(f.counters, j / 2) ?? 0
    if j % 2 == 0
        return byte & 0x0F
    byte >> 4

fn set_counter(var f: BlCountingFilter, j: Int, value: Int)
    let byte = bytes.byte_at(f.counters, j / 2) ?? 0
    if j % 2 == 0
        bytes.set_u8(f.counters, j / 2, (byte & 0xF0) | value)
    else
        bytes.set_u8(f.counters, j / 2, (byte & 0x0F) | (value << 4))
