// blfault.nv — the ways a filter or an operation can be refused.
//
// Every filter here is sized for a number of items and a false-positive
// rate, and each stops honouring that rate once more items go in than
// it was sized for.  A Bloom filter degrades gradually: the rate
// climbs.  A cuckoo filter fails at once: an insert is refused.
//
// A counting filter whose counter would overflow refuses the insert
// rather than wrapping.  A wrapped counter lets a later `remove` clear
// a position other items need, and the filter would then report false
// negatives, which is the one answer these structures never give.

// Why a filter or an operation was refused.
//
// ```novo
// use blfault
//
// fn main() [io]
//     println(blfault.code(BlCapacityNotPositive(0)))
// ```
pub enum BlFault
    // The expected item count is zero or negative, so the filter has
    // no size to compute from.
    BlCapacityNotPositive(capacity: Int)
    // The false-positive target is not in `0.0 ..< 1.0`, exclusive of
    // both ends: a rate of zero needs an exact set and a rate of one
    // is a filter that says yes to everything.
    BlTargetOutOfRange(target: Float)
    // A cuckoo filter could not place an item: it relocated others
    // until it hit its kick limit.  The filter is full, and a caller
    // that keeps inserting needs a bigger one.
    BlCuckooFull(kicks: Int)
    // A counting filter's counter is already at its maximum, so
    // another insert would wrap and make a later `remove` produce a
    // false negative.
    BlCounterSaturated(index: Int)
    // A `remove` named an item the filter can prove it was never
    // given.  Removing it would clear state that belongs to items that
    // were added, and the filter would start answering `false` for
    // things it holds.
    BlRemoveOfUnknownItem
    // Two filters have different sizes or different hash counts, so
    // their bits do not line up and no union of them means anything.
    BlShapeMismatch(left: Str, right: Str)
    // Two filters were fed through different hashes.  The same item
    // sets different bits under different hashes, so a union would
    // answer `false` for an item one of them holds.
    BlHashMismatch(left: Str, right: Str)
    // A serialised filter could not be read.
    BlBadSerialisedForm(why: Str)

// `BlFault` is an `Error`, so it can stand in `Result<T, BlFault>`.
impl Error for BlFault
    // The one-line message, naming what was given and what was
    // required.
    fn message(self) -> Str
        match self
            BlCapacityNotPositive(n)  => "the capacity is ${n} and must be above zero"
            BlTargetOutOfRange(t)     => "the target rate is ${t} and must be above 0 and below 1"
            BlCuckooFull(kicks)       => "the cuckoo filter is full: no place found after ${kicks} relocations"
            BlCounterSaturated(index) => "counter ${index} is at 15 and one more add would wrap it"
            BlRemoveOfUnknownItem     => "the item was never added, so it cannot be removed"
            BlShapeMismatch(l, r)     => "the filters differ in shape: ${l} against ${r}"
            BlHashMismatch(l, r)      => "the filters were fed different hashes: ${l} against ${r}"
            BlBadSerialisedForm(why)  => "not a serialised filter: ${why}"

// A short stable code for a log: `"capacity_not_positive"`,
// `"target_out_of_range"`, `"cuckoo_full"`, `"counter_saturated"`,
// `"remove_of_unknown_item"`, `"shape_mismatch"`, `"hash_mismatch"` and
// `"bad_serialised_form"`.
//
// ```novo
// use blfault
//
// fn main() [io]
//     println(blfault.code(BlCuckooFull(500)))
// ```
pub fn code(f: BlFault) -> Str
    match f
        BlCapacityNotPositive(_) => "capacity_not_positive"
        BlTargetOutOfRange(_)    => "target_out_of_range"
        BlCuckooFull(_)          => "cuckoo_full"
        BlCounterSaturated(_)    => "counter_saturated"
        BlRemoveOfUnknownItem    => "remove_of_unknown_item"
        BlShapeMismatch(_, _)    => "shape_mismatch"
        BlHashMismatch(_, _)     => "hash_mismatch"
        BlBadSerialisedForm(_)   => "bad_serialised_form"

// Whether the fault means the filter is full rather than that the call
// was wrong.
//
// True for `BlCuckooFull` and `BlCounterSaturated`.  A caller counts
// these separately and rebuilds at a larger size.  The others are
// mistakes in the calling code.
//
// ```novo
// use blfault
//
// fn main() [io]
//     println("${blfault.is_capacity_fault(BlCuckooFull(500))}")    // true
// ```
pub fn is_capacity_fault(f: BlFault) -> Bool
    match f
        BlCuckooFull(_)       => true
        BlCounterSaturated(_) => true
        _                     => false
